# Railway sets DATABASE_URL automatically once you attach a Postgres plugin
# to this project. For local testing, point it at your own Postgres.
DATABASE_URL=postgres://user:password@localhost:5432/alire

# Shared secret the frontend sends back on every API call (header
# X-App-Key). Pick any long random string. Required in production.
APP_KEY=change-me-to-a-long-random-string

# Optional. Set to "disable" only if your Postgres provider rejects SSL
# entirely (Railway's own Postgres works fine with the default).
# PGSSL=disable

# Railway sets PORT automatically; only needed for local runs.
PORT=3000
